# MASTER CLAUDE QA secrets — copy to .env (git-ignored) and fill in.
# Naming convention: MC_QA_<SERVICE>_<ENV>_<KEY>
# Values are referenced from env profile files as "${env:NAME}" placeholders.
# NEVER commit real values. NEVER put secrets in env profile JSON files.

# --- example (example.com — the working, same-origin deployment) ---
# Two ways to get an authenticated session:
#  1) `pnpm qa login` — headed browser, you log in yourself (works with 2FA); saves only the session.
#  2) `pnpm qa login --scripted` — non-interactive login from PHONE+PASS below (needs 2FA DISABLED
#     on the test account). The password is read here, never logged or stored anywhere but the
#     browser field, and only the session cookie is saved.
MC_QA_EXAMPLE_PRODTEST_PHONE=
MC_QA_EXAMPLE_PRODTEST_PASS=
MC_QA_EXAMPLE_PRODREAL_PHONE=
MC_QA_EXAMPLE_STAGING_BASEURL=
MC_QA_EXAMPLE_STAGING_PHONE=
